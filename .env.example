# Copy this file to `.env` (same directory as manage.py) and fill in real values.
# `.env` is git-ignored — never commit it. This example file contains no secrets
# and IS committed, so future developers know which variables the app needs.

# --- Django ---
# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-random-50-char-string

# True only on your local machine. Must be False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Razorpay ---
# From https://dashboard.razorpay.com -> Settings -> API Keys.
# Use rzp_test_* keys for development; rzp_live_* only in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
